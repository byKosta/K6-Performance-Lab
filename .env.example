# Copy to .env (gitignored), fill in, then load before running k6:
#   set -a; source .env; set +a
# k6 reads shell env vars into __ENV automatically.

API_KEY=           # itemit x-api-key (ask the team / take from test-web Network tab)
EMAIL=             # test account
PASSWORD=
WORKSPACE_ID=      # dedicated workspace for soak/ramp/spike (don't pollute Team)

# data-volume comparison
DIRTY_WORKSPACE_ID=
CLEAN_WORKSPACE_ID=

# BASE_URL=https://test-api.itemit.com
# FRONT_URL=https://test-web.itemit.com
